<Application x:Class="ClaudeVpnGuard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClaudeVpnGuard"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
    <local:BoolToGuardLabelConverter x:Key="BoolToGuardLabelConverter"/>
    <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <local:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
    <local:NavActiveConverter x:Key="NavActiveConverter"/>
    <local:EventDotConverter x:Key="EventDotConverter"/>

    <Color x:Key="BgColor">#070A12</Color>
    <Color x:Key="PanelColor">#121826</Color>
    <Color x:Key="SidebarColor">#0C1220</Color>
    <Color x:Key="TextColor">#EAF0FF</Color>
    <Color x:Key="MutedColor">#8B97B3</Color>
    <Color x:Key="GreenColor">#2ECC71</Color>
    <Color x:Key="BlueColor">#3B82F6</Color>
    <Color x:Key="RedColor">#FF4D6D</Color>
    <Color x:Key="YellowColor">#FFC857</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="YellowBrush" Color="{StaticResource YellowColor}"/>
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource GreenColor}"/>
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource RedColor}"/>
    <SolidColorBrush x:Key="GreenGlowBrush" Color="#1A2ECC71"/>
    <SolidColorBrush x:Key="BlueGlowBrush" Color="#1A3B82F6"/>
    <SolidColorBrush x:Key="RedGlowBrush" Color="#22FF4D6D"/>
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1AFFFFFF"/>

    <Style x:Key="GlassCard" TargetType="Border">
      <Setter Property="Background" Value="#CC121826"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryBlueButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource BlueBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="#1AFFFFFF"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PillGreen" TargetType="Border">
      <Setter Property="Background" Value="#1A2ECC71"/>
      <Setter Property="BorderBrush" Value="#552ECC71"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#1A222F"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="#2A3548"/>
    </Style>
  </Application.Resources>
</Application>
