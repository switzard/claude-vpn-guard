<Window x:Class="ClaudeVpnGuard.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Guard HUD"
        Icon="Assets/app.ico"
        Width="320" Height="214"
        MinWidth="300" MinHeight="200"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0a0e12"
        SourceInitialized="OnSourceInitialized">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0"
                  ResizeBorderThickness="4"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Border CornerRadius="12" Background="#0a0e12" ClipToBounds="True" BorderBrush="#1e2a32" BorderThickness="1">
    <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#0a0e12"/>
  </Border>
</Window>
