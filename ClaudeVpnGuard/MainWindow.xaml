<Window x:Class="ClaudeVpnGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude VPN Guard"
        Height="720" Width="920"
        MinHeight="640" MinWidth="820"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Brand / status -->
    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,18">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="CLAUDE VPN GUARD"
                   FontSize="28" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="{Binding StatusSummary}"
                   FontSize="14" Margin="0,6,0,0"
                   Foreground="{StaticResource TealBrush}"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" VerticalAlignment="Center"
              Background="{StaticResource PanelBrush}"
              CornerRadius="10" Padding="14,8" Margin="16,0,0,0">
        <TextBlock Text="{Binding ClaudeAllowedText}"
                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
      </Border>
    </DockPanel>

    <!-- Reminder banner -->
    <Border Grid.Row="1" Margin="0,0,0,16"
            Background="#1AFF5A5F" BorderBrush="{StaticResource CoralBrush}"
            BorderThickness="1" CornerRadius="12" Padding="16,12"
            Visibility="{Binding Reminder, Converter={StaticResource NullToCollapsedConverter}}">
      <StackPanel>
        <TextBlock Text="Location reminder" Foreground="{StaticResource CoralBrush}" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Reminder}" Foreground="{StaticResource TextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left column -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Tunnel" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding TunnelDetail}" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,10" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding GeoDetail}" Foreground="{StaticResource TealBrush}" Margin="0,0,0,12"/>
              <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0"
                                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                 Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Location lock" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Guard reminds you to enable this exit location and can block Claude until it matches."
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
              <TextBlock Text="Target country" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              <ComboBox ItemsSource="{Binding Countries}"
                        SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                        Margin="0,6,0,12"
                        Background="#1A2228" Foreground="{StaticResource TextBrush}"
                        BorderBrush="#2A333A"/>
              <CheckBox Content="Strict location (block Claude until country matches)"
                        IsChecked="{Binding StrictLocation}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
              <CheckBox Content="Guard enabled" IsChecked="{Binding GuardEnabled}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
              <CheckBox Content="Kill Claude instead of suspend on VPN drop" IsChecked="{Binding KillMode}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
              <CheckBox Content="Start Guard with Windows" IsChecked="{Binding StartWithWindows}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,14"/>
              <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Right column -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Claude processes" Style="{StaticResource SectionTitle}"/>
              <ItemsControl ItemsSource="{Binding ClaudeProcesses}" Margin="0,8,0,0">
                <ItemsControl.Style>
                  <Style TargetType="ItemsControl">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ClaudeProcesses.Count}" Value="0">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate>
                              <TextBlock Text="No Claude Code / Desktop processes" Foreground="{StaticResource MutedBrush}"/>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel Margin="0,0,0,6">
                      <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                      <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}">
                        <Run Text="PID "/><Run Text="{Binding Pid, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding State}"/>
                      </TextBlock>
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Autostart watch" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="{Binding AutostartFindings}" Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap" Margin="0,6,0,10"/>
              <Button Content="Disable Claude Run-key autostart" Command="{Binding DisableClaudeAutostartCommand}"
                      Style="{StaticResource GhostButton}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Account hygiene" Style="{StaticResource SectionTitle}"/>
              <TextBlock Text="Community-reported signals (unverified). Guard enforces only network hygiene."
                         Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" FontSize="12"/>
              <ItemsControl ItemsSource="{Binding HygieneTips}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="0,0,0,10" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                          <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center"
                                     Foreground="{StaticResource TealBrush}"
                                     Text="{Binding EnforcedByGuard, Converter={StaticResource BoolToGuardLabelConverter}}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Body}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
              <TextBlock Text="Event journal" Style="{StaticResource SectionTitle}"/>
              <ItemsControl ItemsSource="{Binding Events}" Height="180" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,0,0,4" FontSize="11" TextWrapping="Wrap">
                      <Run Foreground="{StaticResource TealBrush}" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"/>
                      <Run Foreground="{StaticResource CoralBrush}" Text="{Binding Kind}"/>
                      <Run Foreground="{StaticResource MutedBrush}" Text="{Binding Message}"/>
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="3" Margin="0,16,0,0" FontSize="11"
               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
               Text="Network hygiene tool for Claude Code and Claude Desktop. You are responsible for complying with Anthropic Terms of Service and local law. No telemetry beyond optional public IP geo lookup."/>
  </Grid>
</Window>
